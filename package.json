{
  "name": "auto-brain",
  "version": "1.0.1",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @beonauto/server dev",
    "key": "pnpm --filter @beonauto/identity key",
    "docs:dev": "cd docs && vitepress dev",
    "docs:build": "cd docs && vitepress build",
    "docs:preview": "cd docs && vitepress preview",
    "docs:taxonomy": "node scripts/docs-function-taxonomy.ts",
    "docs:taxonomy:check": "node scripts/docs-function-taxonomy.ts --check",
    "docs:test": "node --test scripts/docs*.test.ts",
    "docs:lint": "oxlint -c .oxlintrc.json scripts/docs*.ts && tsc --project scripts/tsconfig.json",
    "docs:check": "pnpm docs:lint && pnpm docs:taxonomy:check && pnpm docs:build && pnpm docs:test",
    "test:watch": "vitest",
    "typecheck:watch": "tsc --watch",
    "check": "pnpm check:tasks && pnpm docs:check",
    "check:tasks": "turbo run format:check lint typecheck test knip sherif",
    "check:ci": "pnpm check:tasks --concurrency=2 && pnpm docs:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint *.ts",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "sherif": "sherif",
    "commit": "czg",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@beonauto/specs": "workspace:*",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "catalog:",
    "czg": "1.14.0",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "sherif": "1.13.0",
    "turbo": "2.11.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitepress": "1.6.4",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
}
