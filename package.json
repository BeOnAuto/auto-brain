{
  "name": "auto-brain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @beonauto/server dev",
    "test:watch": "vitest",
    "typecheck:watch": "tsc --watch",
    "check": "turbo run format:check lint typecheck test knip sherif",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint *.ts",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "sherif": "sherif",
    "commit": "czg",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "catalog:",
    "czg": "1.14.0",
    "knip": "6.38.0",
    "lefthook": "2.1.15",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "sherif": "1.13.0",
    "turbo": "2.11.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "pnpm@12.8.1"
}
