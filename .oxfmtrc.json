{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "sortImports": {},
  "ignorePatterns": ["**/coverage/**", "**/dist/**", "**/.wrangler/**", "pnpm-lock.yaml", "CHANGELOG.md"],
  "overrides": [{ "files": ["**/*.json", "**/*.jsonc"], "options": { "trailingComma": "none" } }]
}
