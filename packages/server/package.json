{
  "name": "@beonauto/server",
  "version": "0.0.0",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "node dev.ts",
    "start": "node src/main.ts",
    "config-schema": "node config-schema.ts",
    "measure": "node measure.ts",
    "container:build": "docker build --file Dockerfile --tag beonauto/auto-brain:local ../..",
    "container:run": "docker run --rm --publish 8080:8080 beonauto/auto-brain:local",
    "lint": "oxlint -c ../../.oxlintrc.json",
    "typecheck": "tsc",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@beonauto/api": "workspace:*",
    "@beonauto/brains": "workspace:*",
    "@beonauto/computation": "workspace:*",
    "@beonauto/config": "workspace:*",
    "@beonauto/identity": "workspace:*",
    "@beonauto/inference": "workspace:*",
    "@beonauto/interaction": "workspace:*",
    "@beonauto/ledger": "workspace:*",
    "@beonauto/mcp": "workspace:*",
    "@beonauto/operations": "workspace:*",
    "@beonauto/orchestration": "workspace:*",
    "@beonauto/recollection": "workspace:*",
    "@beonauto/specs": "workspace:*",
    "@beonauto/workflow-engine": "workspace:*",
    "@beonauto/workflow-host": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "pg": "8.23.1",
    "vitest": "catalog:"
  }
}
