{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "auto-brain",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "BrainContainer",
      "image": "../../Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BRAIN", "class_name": "BrainContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BrainContainer"] }]
}
