{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "mode": "full",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "minimumReleaseAge": "1 day",
  "rangeStrategy": "pin",
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "matchFileNames": ["packages/server/Dockerfile"],
      "groupName": "container base image",
      "groupSlug": "container-base-image"
    },
    {
      "description": "typescript6 is TypeScript 6 under an alias, the last version with the compiler API the program check of the definitions package calls, so it stays below 7; an alias is matched by its dependency name, since its package name is typescript",
      "matchDepNames": ["typescript6"],
      "allowedVersions": "<7"
    },
    {
      "description": "dumbo's 0.13.0-betabeta.50 is a mistyped tag published as latest, which semver ranks above every 0.13.0-beta.N; dumbo and emmett never take a version whose prerelease tag holds betabeta",
      "matchPackageNames": ["@event-driven-io/dumbo", "@event-driven-io/emmett"],
      "allowedVersions": "!/betabeta/"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images the workflows run in their steps, pinned by tag and digest",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "\\s(?<depName>[a-z0-9][a-z0-9./-]*):(?<currentValue>[A-Za-z0-9._-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
